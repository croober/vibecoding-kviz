{
  "name": "kviz",
  "version": "1.0.0",
  "description": "Generátor kvízových otázek přes Claude API s bodováním týmů",
  "main": "server.js",
  "scripts": {
    "start": "node --env-file-if-exists=.env server.js",
    "dev": "node --watch --env-file-if-exists=.env server.js",
    "android:prepare": "node android-tv/prepare.mjs",
    "cap:sync": "npm run android:prepare && cap sync android",
    "android:debug": "npm run cap:sync && cd android && gradlew.bat assembleDebug",
    "test:tv": "node --test android-tv/core.test.js android-tv/link-core.test.js"
  },
  "author": "Tomáš Musiol",
  "license": "MIT",
  "type": "module",
  "dependencies": {
    "@anthropic-ai/sdk": "^1.5.0",
    "@capacitor/android": "^6.2.3",
    "@capacitor/app": "^6.0.3",
    "@capacitor/core": "^6.2.3",
    "express": "^5.3.0"
  },
  "engines": {
    "node": ">=22"
  },
  "devDependencies": {
    "@capacitor/cli": "^6.2.3",
    "@fontsource-variable/bricolage-grotesque": "^5.3.0",
    "@fontsource/inter": "^5.3.0",
    "@phosphor-icons/web": "^2.1.1",
    "qrcode-generator": "^2.0.4"
  }
}
